rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== helpers =====
    function isAuthed() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function isActive() {
      return isAuthed() && userDoc().activo == true;
    }
    function hasPerm(p) {
      return isActive() && userDoc().permisos[p] == true;
    }
    function isAdmin() {
      return isActive() && userDoc().rol == 'admin';
    }

    // ===== directorio: lista pública de nombres para la pantalla de login =====
    match /directorio/{uid} {
      allow read: if true;
      allow write: if isAdmin() || hasPerm('gestionar_usuarios');
    }

    // ===== usuarios: perfil, rol y permisos =====
    match /usuarios/{uid} {
      allow read: if isActive();
      // cada quien puede actualizar SOLO sus tokens de notificaciones
      allow update: if isAuthed() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens']);
      // gestionar usuarios (crear/editar/permisos) requiere permiso
      allow create, delete: if isAdmin() || hasPerm('gestionar_usuarios');
      allow update: if isAdmin() || hasPerm('gestionar_usuarios');
    }

    // ===== stock: lectura pública (el catálogo muestra disponibilidad), escritura protegida =====
    match /stock/{code} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if hasPerm('editar_stock')
        && request.resource.data.cantidad is number
        && request.resource.data.cantidad >= 0
        && request.resource.data.stockMinimo is number
        && request.resource.data.stockMinimo >= 0;
      allow delete: if isAdmin();
    }

    // ===== movimientos: historial inmutable (solo se crea, jamás se edita o borra) =====
    match /movimientos/{id} {
      allow read: if hasPerm('ver_historial');
      allow create: if hasPerm('editar_stock');
      allow update, delete: if false;
    }
  }
}
